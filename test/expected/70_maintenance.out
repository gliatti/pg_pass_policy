SELECT s.role_name, s.role_oid = s.role_name::regrole::oid AS oid_ok
  FROM pass_policy.role_state s WHERE s.role_name IN ('regress_rx', 'regress_ry')
 ORDER BY 1;
 role_name  | oid_ok 
------------+--------
