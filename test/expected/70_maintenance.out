---------------------+---------------
 regress_maint       | expired
 regress_maint_grace | grace
 regress_maint_never | never_expires
 regress_maint_warn  | warning
(4 rows)

SELECT role_name, status FROM pass_policy.v_expiring
 WHERE role_name LIKE 'regress\_maint%' ORDER BY role_name;
