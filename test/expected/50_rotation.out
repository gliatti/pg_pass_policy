-- (vérification) Longueur par défaut relevée à la somme des minima de classes :
-- min_digit = 30 (somme 33 > 24) donnait 22023 avec least(greatest(24, min_length), max_length)
CREATE ROLE regress_rotcls LOGIN;
SELECT pass_policy.create_profile('p_rotcls', '{"min_digit": 30, "max_length": 64, "min_age": "0"}') > 0 AS created;
 created 
---------
 t
(1 row)

SELECT pass_policy.assign_profile('regress_rotcls', 'p_rotcls');
 assign_profile 
----------------
 
(1 row)

INSERT INTO ppp_test.secrets
  SELECT 'rotcls', pass_policy.rotate_password('regress_rotcls');
SELECT length(pwd) AS len_classes,
       length(regexp_replace(pwd, '[^0-9]', '', 'g')) >= 30 AS digits_ok
  FROM ppp_test.secrets WHERE label = 'rotcls';
 len_classes | digits_ok 
-------------+-----------
          33 | t
(1 row)

-- somme des minima bornée par max_length : 64 tient, 65 non
SELECT ppp_test.try($$SELECT pass_policy.alter_profile('p_rotcls', '{"min_digit": 61}')$$) AS classes_fit_64;
 classes_fit_64 
----------------
 ok
(1 row)

SELECT ppp_test.try($$SELECT pass_policy.alter_profile('p_rotcls', '{"min_digit": 62}')$$) AS classes_over_max;
 classes_over_max 
------------------
 23514
(1 row)

INSERT INTO ppp_test.secrets
  SELECT 'rotcls64', pass_policy.rotate_password('regress_rotcls');
SELECT length(pwd) AS len_classes_max FROM ppp_test.secrets WHERE label = 'rotcls64';
 len_classes_max 
-----------------
              64
(1 row)

-- (vérification 2) Longueur par défaut relevée au besoin réel du générateur :
-- min_digit = 30, autres minima à 0, min_classes = 3 : somme 30, mais
-- generate_password() tire toujours une minuscule et une majuscule (32)
CREATE ROLE regress_rotgen LOGIN;
SELECT pass_policy.create_profile('p_rotgen', '{"min_lower": 0, "min_upper": 0, "min_digit": 30, "min_special": 0, "min_classes": 3, "min_length": 8, "max_length": 64, "min_age": "0"}') > 0 AS created;
 created 
---------
 t
(1 row)

SELECT pass_policy.assign_profile('regress_rotgen', 'p_rotgen');
 assign_profile 
----------------
 
(1 row)

INSERT INTO ppp_test.secrets
  SELECT 'rotgen', pass_policy.rotate_password('regress_rotgen');
SELECT length(pwd) AS len_gen,
       length(regexp_replace(pwd, '[^0-9]', '', 'g')) >= 30 AS digits_ok
  FROM ppp_test.secrets WHERE label = 'rotgen';
 len_gen | digits_ok 
---------+-----------
      32 | t
(1 row)

-- min_classes = 4 : un spécial forcé en plus (33)
SELECT pass_policy.alter_profile('p_rotgen', '{"min_classes": 4}');
 alter_profile 
---------------
 
(1 row)

INSERT INTO ppp_test.secrets
  SELECT 'rotgen4', pass_policy.rotate_password('regress_rotgen');
SELECT length(pwd) AS len_gen4 FROM ppp_test.secrets WHERE label = 'rotgen4';
 len_gen4 
----------
       33
(1 row)

-- profil impossible pour le générateur refusé (33 > 32)
SELECT ppp_test.try($$SELECT pass_policy.alter_profile('p_rotgen', '{"max_length": 32}')$$) AS gen_impossible;
 gen_impossible 
----------------
 23514
(1 row)

-- (clôture) _record_done() : drapeau posé par le hook pour la transaction
-- courante ; une seule ligne d'historique par rotation (pas de doublon par
-- _ensure_recorded())
BEGIN;
SELECT pass_policy._record_done('regress_rot32') AS before_rotation;
 before_rotation 
-----------------
 f
(1 row)

INSERT INTO ppp_test.secrets
  SELECT 'rot32b', pass_policy.rotate_password('regress_rot32');
SELECT pass_policy._record_done('regress_rot32') AS after_rotation,
       pass_policy._record_done('regress_rot') AS other_role;
 after_rotation | other_role 
----------------+------------
 t              | f
(1 row)

COMMIT;
SELECT pass_policy._record_done('regress_rot32') AS after_commit;
 after_commit 
--------------
 f
(1 row)

SELECT count(*) AS history_rows FROM pass_policy.password_history WHERE role_name = 'regress_rot32';
 history_rows 
--------------
            3
(1 row)

SELECT count(*) AS changed_rows FROM pass_policy.audit_log
 WHERE event_type = 'password_changed' AND role_name = 'regress_rot32';
 changed_rows 
--------------
            3
(1 row)

-- drapeau retiré par l'annulation de la sous-transaction qui l'a posé
BEGIN;
SAVEPOINT s;
INSERT INTO ppp_test.secrets
  SELECT 'rot32c', pass_policy.rotate_password('regress_rot32');
ROLLBACK TO SAVEPOINT s;
SELECT pass_policy._record_done('regress_rot32') AS after_rollback_to_savepoint;
 after_rollback_to_savepoint 
-----------------------------
 f
(1 row)

ROLLBACK;
-- Nom de rôle nécessitant des guillemets (format %I)
CREATE ROLE "regress_Rot quoted" LOGIN;
INSERT INTO ppp_test.secrets
  SELECT 'rot_quoted', pass_policy.rotate_password('regress_Rot quoted');
SELECT rolpassword LIKE 'SCRAM-SHA-256$%' AS scram
  FROM pg_authid WHERE rolname = 'regress_Rot quoted';
 scram 
-------
 t
(1 row)

