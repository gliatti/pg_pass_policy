-- Nom sans rôle : refusé (vérification 12), aucune entrée créée
SELECT ppp_test.try($$SELECT pass_policy.shmem_lock_role('regress_no_such_role', NULL)$$) AS shmem_lock_missing;
 shmem_lock_missing 
--------------------
 42704
(1 row)

